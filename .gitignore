# =============================================================================
# MeliVision / MetricLearning — .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
paper
/paper/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual environment ---
.venv/
venv/
ENV/
env/

# --- Secrets / credentials ---
.env
.env.*
*.pem
credentials.json

# --- PyTorch weights & checkpoints ---
*.pth
*.pt
*.ckpt
*.onnx
checkpoints/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints/

# --- IDEs & OS ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.code-workspace

# --- Logs & experiment tracking ---
logs/
*.log
tensorboard/
wandb/

# --- Training runs & generated outputs ---
runs/*
!runs/.gitkeep
experiments/
reports/
evaluation/
ablations/
images/

# --- Data (user-provided; not versioned) ---
data/*
!data/.gitkeep
*.h5
*.hdf5
*.faiss
*.index

# --- Binary / media (datasets, figures, archives) ---
*.jpg
*.jpeg
*.png
*.tiff
*.tif
*.bmp
*.gif
*.svg
*.webp
*.npy
*.npz
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# Allow Python source packages named like ignored dirs
!src/data/
!src/models/

# --- Model weights directory at repo root (download via setup_u2net.py) ---
/models/
!models/.gitkeep

# --- Config backups (local only) ---
config.yaml.backup
config.backup_*.yaml
*.backup

# --- Root-level scratch scripts & local artifacts ---
/test_shape.py
/test_shape2.py
/test_hybrid.py
/test_ldm.py
/test_pipeline.py
/training_metrics.csv
/data_BKP*.zip
/mantos_*.png
/smoke_multi_tower.log

# --- Generated metrics / plots in scripts ---
scripts/graphsss/*.csv

# --- Documentation (local only; public doc = /README.md) ---
docs/
*.md
!/README.md

# --- Tests (local only) ---
tests/

# --- Cache & coverage ---
.cache/
*.cache
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Temporary ---
tmp/
temp/
*.tmp
